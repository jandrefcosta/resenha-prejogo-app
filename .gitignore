# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Reconnaissance artifacts (in-progress; move to docs/ when confirmed)
/_reconnaissance/

# ──────────────────────────────────────────────────────────────
# Dependencies
# ──────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ──────────────────────────────────────────────────────────────
# Build & runtime artifacts
# ──────────────────────────────────────────────────────────────
/.next/
/out/
/build
/dist

# Next.js + Serwist generated service worker files
public/sw.js
public/sw.js.map
public/swe-worker*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# ──────────────────────────────────────────────────────────────
# Testing
# ──────────────────────────────────────────────────────────────
/coverage
/test-results
/playwright-report
/blob-report
playwright/.cache

# ──────────────────────────────────────────────────────────────
# Environment & secrets
# ──────────────────────────────────────────────────────────────
.env*
!.env.example

# ──────────────────────────────────────────────────────────────
# Logs & debug
# ──────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ──────────────────────────────────────────────────────────────
# Tooling caches
# ──────────────────────────────────────────────────────────────
/.cache
.eslintcache
.stylelintcache

# ──────────────────────────────────────────────────────────────
# Graphify (auto-generated knowledge graph artifacts)
# ──────────────────────────────────────────────────────────────
/graphify-out/
.graphify_python
.graphify_*.json
.graphify_uncached.txt

# ──────────────────────────────────────────────────────────────
# PDF pipeline (regenerable, 50MB+)
# ──────────────────────────────────────────────────────────────
/scripts/pdfs/
/scripts/round-map.json

# Temporary debug scripts (remove these once features are stable)
scripts/_debug_pdf.mjs
scripts/debug-pdf.ts
scripts/debug-regex.mjs
scripts/reparse-boletins.mjs
scripts/debug-boletim-text.ts
scripts/diagnose-match-docs.ts
scripts/check-status-urls.ts

# ──────────────────────────────────────────────────────────────
# Python (used by skills under .claude/skills/)
