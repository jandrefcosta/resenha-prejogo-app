{
  "name": "resenha-prejogo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed:cbf": "tsx --env-file=.env.local scripts/seed-cbf.ts",
    "seed:match-docs": "tsx --env-file=.env.local scripts/seed-match-docs.ts",
    "seed:form": "tsx --env-file=.env.local scripts/seed-form.ts",
    "seed:fixtures": "tsx --env-file=.env.local scripts/seed-fixtures.ts",
    "seed:past-results": "tsx --env-file=.env.local scripts/seed-past-results.ts",
    "seed:all": "tsx --env-file=.env.local scripts/seed-all.ts",
    "test:e2e": "playwright test",
    "docs:download": "node scripts/download-pdfs.mjs",
    "docs:parse": "node scripts/parse-pdfs.mjs",
    "docs:build": "node scripts/build-match-docs.mjs",
    "docs:update": "node scripts/download-pdfs.mjs && node scripts/parse-pdfs.mjs && node scripts/build-match-docs.mjs",
    "docs:cron": "node scripts/cron-match-docs.mjs",
    "graphify:update": "python -c \"from graphify.watch import _rebuild_code; from pathlib import Path; _rebuild_code(Path('.'))\"",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@google/genai": "^1.47.0",
    "@heroicons/react": "^2.2.0",
    "@sentry/nextjs": "^10.47.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "graphify": "^1.0.0",
    "jose": "^6.2.2",
    "nanoid": "^5.1.9",
    "next": "16.2.1",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.2",
    "unpdf": "^1.4.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@serwist/turbopack": "^9.5.7",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "serwist": "^9.5.7",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
